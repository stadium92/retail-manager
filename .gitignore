# Dependencies
node_modules/
.pnpm-store/

# Build outputs
dist/
build/
out/
.next/
src-tauri/target/
frontend/dist/

# Ignore src-tauri except code and key config/build files
src-tauri/*
!src-tauri/src/
!src-tauri/src/**
!src-tauri/Cargo.lock
!src-tauri/Cargo.toml
!src-tauri/tauri.conf.json
!src-tauri/build.rs
!src-tauri/icons/
!src-tauri/icons/**

# Ignore binaries in src-tauri
src-tauri/binaries/*
!src-tauri/binaries/.gitkeep

# System
.DS_Store
Thumbs.db

# Environment
.env
.env.local
.env.*.local

# Logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# User specified
backup/
!scripts/
!docs/

notes
release
data
