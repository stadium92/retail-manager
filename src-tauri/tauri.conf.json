{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "retail-manager",
  "version": "0.1.0",
  "identifier": "com.retailmanager.app",
  "build": {
    "frontendDist": "../frontend/dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "pnpm --prefix ../frontend run dev",
    "beforeBuildCommand": ""
  },
  "app": {
    "windows": [
      {
        "title": "Retail Manager",
        "width": 800,
        "height": 600,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "externalBin": [
      "binaries/local-bridge"
    ],
    "resources": [
      "binaries/better_sqlite3.node"
    ],
    "icon": [
      "icons/icon_32.png",
      "icons/icon_128.png",
      "icons/icon_256.png",
      "icons/icon_512.png",
      "icons/icon_1024.png",
      "icons/icon.icns"
    ]
  }
}
