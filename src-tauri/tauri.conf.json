{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "retail-manager",
  "version": "0.2.25",
  "identifier": "com.retailmanager.app",
  "build": {
    "frontendDist": "../frontend/dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm --prefix ../frontend run dev",
    "beforeBuildCommand": ""
  },
  "app": {
    "windows": [
      {
        "title": "Retail Manager",
        "width": 800,
        "height": 600,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": "default-src 'self' 'unsafe-inline' 'unsafe-eval' tauri: https: http: ws: wss: data: blob:;"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "externalBin": [
      "binaries/local-bridge"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "createUpdaterArtifacts": true,
    "windows": {
      "nsis": {
        "installerIcon": "icons/icon.ico"
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEY4REQwNDlCOTBFMTYyNzMKUldSell1R1Ftd1RkK09KdGRaMWVKVWJ0Wis5Uzc2RkV2Und6TTVpTUlGSitHWEZyZzJpaVBXeG4K",
      "endpoints": [
        "https://raw.githubusercontent.com/stadium94/app-releases/main-niamana-dubai/latest.json"
      ]
    }
  }
}
