{
  "name": "local-bridge",
  "version": "0.4.3",
  "private": true,
  "bin": "dist/index.js",
  "pkg": {
    "assets": [
      "dist/**/*"
    ],
    "targets": [
      "node18-macos-arm64"
    ],
    "outputPath": "../../src-tauri/binaries"
  },
  "engines": {
    "node": "18.x"
  },
  "scripts": {
    "dev": "tsx src/index.ts",
    "start": "node --enable-source-maps dist/index.js",
    "build": "tsc -p tsconfig.json",
    "obfuscate": "javascript-obfuscator ./dist --output ./dist --compact true --control-flow-flattening true --dead-code-injection true --string-array true --string-array-encoding base64",
    "seed": "tsx src/seed.ts"
  },
  "dependencies": {
    "@fastify/cors": "^9.0.1",
    "bcryptjs": "^2.4.3",
    "better-sqlite3": "9.4.3",
    "dotenv": "^16.4.7",
    "drizzle-orm": "^0.45.1",
    "fastify": "^4.29.1",
    "jsonwebtoken": "^9.0.3",
    "zod": "^3.25.6"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/better-sqlite3": "^7.6.13",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^22.16.5",
    "@yao-pkg/pkg": "^6.12.0",
    "caxa": "^3.0.1",
    "javascript-obfuscator": "^5.2.1",
    "pkg": "^5.8.1",
    "tsx": "^4.21.0",
    "typescript": "^5.8.3"
  }
}
